{
  "name": "@tkbk/mcp",
  "version": "0.3.0",
  "description": "MCP servers for Russian marketplaces, CRMs, advertising and company data: Wildberries, Ozon, Yandex Market, Bitrix24, amoCRM, Avito, Yandex Direct, Yandex Metrika, Yandex Webmaster, DaData. Works with Claude Code, Cursor, Claude Desktop — locally over stdio or hosted over Streamable HTTP.",
  "type": "module",
  "bin": {
    "tkbk-mcp": "src/cli.mjs"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "start": "node src/cli.mjs http",
    "key-id": "node src/cli.mjs key-id"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkbk-online/tkbk-mcp.git"
  },
  "homepage": "https://tkbk.online/mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wildberries",
    "ozon",
    "yandex-market",
    "bitrix24",
    "amocrm",
    "avito",
    "yandex-direct",
    "yandex-metrika",
    "yandex-webmaster",
    "dadata",
    "claude-code",
    "cursor"
  ]
}
